APP_NAME="Cinema ITO"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://168.231.75.27
FRONTEND_URL=http://168.231.75.27

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cine_ito
